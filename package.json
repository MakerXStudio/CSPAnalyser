{
  "name": "@makerx/csp-analyser",
  "version": "1.3.0",
  "type": "module",
  "description": "Headlessly browse websites with a deny-all report-only CSP, capture violations, and generate production-ready CSP policies",
  "license": "MIT",
  "keywords": [
    "csp",
    "content-security-policy",
    "security",
    "mcp",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MakerXStudio/CSPAnalyser.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js",
      "default": "./dist/playwright.js"
    },
    "./playwright/reporter": {
      "types": "./dist/playwright-reporter.d.ts",
      "import": "./dist/playwright-reporter.js",
      "default": "./dist/playwright-reporter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "csp-analyser": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "audit": "better-npm-audit audit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "start": "node dist/mcp-server.js",
    "cli": "node dist/cli.js",
    "docs:dev": "vitepress dev docs",
    "docs:csp": "node dist/cli.js hash-static docs/.vitepress/dist --inject --extra style-src-elem='sha256-skqujXORqzxt1aE0NNXxujEanPTX6raoqSscTV/Ww/Y='",
    "predocs:build": "npm run build",
    "docs:build": "vitepress build docs && npm run docs:csp",
    "docs:preview": "vitepress preview docs",
    "example:vite-react:dev": "vite --config examples/vite-react-client/vite.config.ts",
    "example:vite-react:build": "vite build --config examples/vite-react-client/vite.config.ts",
    "example:vite-react:preview": "vite preview --config examples/vite-react-client/vite.config.ts",
    "example:vite-react:e2e": "npm run build && npm run example:vite-react:build && npm run example:vite-react:clean && playwright test -c examples/vite-react-client/playwright.config.ts",
    "example:vite-react:csp": "npm run example:vite-react:e2e && node examples/vite-react-client/scripts/compare-csp-policy.mjs",
    "example:vite-react:csp:update": "npm run example:vite-react:e2e && node examples/vite-react-client/scripts/compare-csp-policy.mjs --update",
    "example:vite-react:clean": "node -e \"const { rmSync } = require('node:fs'); rmSync('examples/vite-react-client/test-results', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.8.0",
    "playwright": "1.59.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.4",
    "better-npm-audit": "^3.11.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "latest",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.4.2",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "latest"
  }
}
